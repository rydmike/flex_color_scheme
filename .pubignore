# Pub publishing ignore file.
#
# IMPORTANT: When a .pubignore file exists in a directory, pub uses it INSTEAD
# of the .gitignore in the same directory when deciding what to publish. This
# root .pubignore must therefore restate the publishing-relevant rules from
# the root .gitignore, in addition to the publish-only exclusions at the end.
# Keep the two files in sync when publishing-relevant rules change.
#
# Sub-directory .gitignore files (like example/.gitignore) still apply.
# Hidden files and directories (starting with a dot) are always excluded by
# pub, so .agents/, .github/, .claude/ and friends need no rules here.
# See https://dart.dev/go/pubignore

# From .gitignore: build output, coverage, logs, IDE and lock files.
build/
coverage/
*.log
*.iml
*.lock
!pubspec.lock

# From .gitignore: generated Claude Code mirror files.
CLAUDE.md
CLAUDE.local.md

# From .gitignore: Flutter tool generated files, regenerated by
# `flutter pub get` and builds. Not tracked in git and not published.
**/generated_plugin_registrant.dart
**/android/**/GeneratedPluginRegistrant.java
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral
**/Flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Publish-only exclusions: internal repository documentation, agent
# configuration masters and repo tooling scripts.
AGENTS.md
docs/
scripts/

# Publish-only exclusions: README images. The README references these via
# GitHub blob URLs with ?raw=true, so pub.dev renders them from GitHub and
# they are not needed inside the published package archive.
#
# NOTE: Do NOT exclude assets/ — assets/opacity.png is a runtime AssetImage
# loaded with package: 'flex_color_picker' and MUST be in the archive.
#
# NOTE: Do NOT exclude example/screenshots/ here. Those files are declared in
# the pubspec.yaml `screenshots:` section and MUST be inside the archive; the
# pub.dev server rejects the upload if they are missing. `dart pub publish
# --dry-run` does not check this, only the server does.
resources/
